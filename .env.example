# MongoDB stores searchable decision metadata and version history.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=change-me
MONGO_DATABASE=kedra
MONGO_COLLECTION=wrc_decisions
MONGO_HOST=localhost
MONGO_PORT=27017

# MinIO stores the raw HTML/PDF/DOC/DOCX document bodies.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=wrc-decisions
MINIO_SECURE=false

# PostgreSQL is reserved for Dagster run/event/schedule metadata.
POSTGRES_USER=dagster
POSTGRES_PASSWORD=change-me
POSTGRES_DATABASE=dagster
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
